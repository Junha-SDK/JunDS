      "default": "row"
    },
    {
      "prop": "align",
      "kind": "select",
      "options": ["start", "center", "end", "stretch", "baseline"],
      "default": "center"
    },
    {
      "prop": "justify",
      "kind": "select",
      "options": ["start", "center", "end", "between", "around", "evenly"],
      "default": "start"
    },
    {
      "prop": "gap",
      "kind": "text",
      "default": "3"
    },
    {
      "prop": "inline",
      "kind": "boolean",
      "default": false
    }
  ],
