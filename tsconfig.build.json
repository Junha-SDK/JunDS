{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "paths": {
      "@/*": ["./*"],
      "@junds/ui": ["./ds/index.ts"]
    }
  },
  "include": ["ds/**/*.ts", "ds/**/*.tsx"],
  "exclude": ["node_modules", "ds/__tests__/**"]
}
