{
  "name": "@junds/web",
  "version": "3.0.0-alpha.0",
  "description": "JunDS v3 — 의존성 0 바닐라 웹 컴포넌트 코어 (Custom Elements v1, light DOM + @layer junds)",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/define.ts",
    "./src/components/*/index.ts",
    "./dist/define.js",
    "./dist/components/*/index.js",
    "./dist/junds.min.js",
    "./dist/**/*.css",
    "./src/styles/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./define": "./dist/define.js",
    "./button": "./dist/components/button/index.js",
    "./button/element": "./dist/components/button/element.js",
    "./text-field": "./dist/components/text-field/index.js",
    "./text-field/element": "./dist/components/text-field/element.js",
    "./modal": "./dist/components/modal/index.js",
    "./modal/element": "./dist/components/modal/element.js",
    "./box": "./dist/components/box/index.js",
    "./box/element": "./dist/components/box/element.js",
    "./center": "./dist/components/center/index.js",
    "./center/element": "./dist/components/center/element.js",
    "./divider": "./dist/components/divider/index.js",
    "./divider/element": "./dist/components/divider/element.js",
    "./flex": "./dist/components/flex/index.js",
    "./flex/element": "./dist/components/flex/element.js",
    "./grid-layout": "./dist/components/grid-layout/index.js",
    "./grid-layout/element": "./dist/components/grid-layout/element.js",
    "./group": "./dist/components/group/index.js",
    "./group/element": "./dist/components/group/element.js",
    "./hstack": "./dist/components/hstack/index.js",
    "./hstack/element": "./dist/components/hstack/element.js",
    "./heading": "./dist/components/heading/index.js",
    "./heading/element": "./dist/components/heading/element.js",
    "./page": "./dist/components/page/index.js",
    "./page/element": "./dist/components/page/element.js",
    "./section": "./dist/components/section/index.js",
    "./section/element": "./dist/components/section/element.js",
    "./text": "./dist/components/text/index.js",
    "./text/element": "./dist/components/text/element.js",
    "./vstack": "./dist/components/vstack/index.js",
    "./vstack/element": "./dist/components/vstack/element.js",
    "./behaviors": "./dist/behaviors/index.js",
    "./behaviors/*": "./dist/behaviors/*.js",
    "./junds.css": "./dist/junds.css",
    "./css/*": "./dist/css/*",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "happy-dom": "^20.0.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
