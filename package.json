{
  "name": "@junds/ui",
  "version": "2.2.0",
  "private": true,
  "description": "JunDS — Premium Design System",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "node scripts/run-server.mjs dev --port 6100",
    "build": "next build",
    "build:lib": "rimraf dist && rollup -c rollup.config.mjs",
    "start": "node scripts/run-server.mjs start --port 6100",
    "locate": "node scripts/locate.mjs",
    "where": "node scripts/locate.mjs",
    "map": "node scripts/build-map.mjs",
    "extract-props": "node scripts/extract-props.mjs",
    "docs:components": "node scripts/generate-components-md.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "capture-screenshots": "node scripts/capture-screenshots.mjs",
    "mcp": "node mcp/server.mjs",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gen": "node scripts/generate-smoke-tests.mjs",
    "stories:gen": "node scripts/generate-stories.mjs",
    "test:types": "vitest run ds/__tests__/types/",
    "validate:requirements": "node scripts/validate-requirements.mjs",
    "audit:a11y": "vitest run --config vitest.a11y.config.ts ds/__tests__/a11y/audit.test.tsx",
    "audit:a11y:strict": "JUNDS_AUDIT_STRICT=1 vitest run --config vitest.a11y.config.ts ds/__tests__/a11y/audit.test.tsx",
    "coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text",
    "coverage:report": "npm run coverage && node scripts/coverage-summary.mjs",
    "extract-css-vars": "node scripts/extract-css-vars.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "build:report": "node scripts/build-bundle-report.mjs && node scripts/build-deps-graph.mjs",
    "bundle:report": "node scripts/build-bundle-report.mjs",
    "deps:report": "node scripts/build-deps-graph.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "prepublishOnly": "npm run build:lib",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "export-tokens": "node scripts/export-tokens.mjs",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.59.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/nextjs": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "^4.11.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "expect-type": "^1.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "next": "16.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.3.5",
    "tailwindcss": "^4",
    "tslib": "^2.8.1",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
