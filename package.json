  "files": [
    "dist",
    "LICENSE"
  ],
  "workspaces": [
    "packages/web",
    "packages/react",
    "packages/finance-data",
    "packages/mcp"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens:gen": "node tokens/build/generate.mjs",
    "tokens:test": "vitest run --config tokens/vitest.config.mjs",
    "tokens:fresh": "node tokens/build/check-fresh.mjs",
    "layout-map:gen": "node scripts/gen-layout-map.mjs",
    "layout-map:check": "node scripts/gen-layout-map.mjs --check",
    "codemod:tokens": "node scripts/codemod-token-vocabulary.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "format:all": "node scripts/format.mjs --all",
    "v3:build": "npm run tokens:gen && npm run build --workspaces --if-present",
    "v3:test": "npm run tokens:test && npm run layout-map:check && npm run test --workspaces --if-present",
    "bench": "node benchmarks/run.mjs",
    "ios:build": "xcodebuild -scheme JunDS -destination 'generic/platform=iOS' build",
    "ios:test": "xcodebuild -scheme JunDS -destination 'platform=iOS Simulator,name=iPhone 15' test",
    "size:web": "node benchmarks/size-gate.mjs",
    "runtime:web": "node benchmarks/runtime-gate.mjs",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "api:check": "node scripts/public-api-gate.mjs",
    "api:update": "node scripts/public-api-gate.mjs --update-baseline",
    "dev": "node scripts/run-server.mjs dev --port 6100",
    "build": "next build",
    "build:lib": "NODE_OPTIONS='--max-old-space-size=8192' rollup -c rollup.config.mjs && node scripts/ensure-use-client-banner.mjs",
    "build:lib:clean": "rimraf dist && npm run build:lib",
    "start": "node scripts/run-server.mjs start --port 6100",
    "locate": "node scripts/locate.mjs",
    "where": "node scripts/locate.mjs",
    "map": "node scripts/build-map.mjs",
    "extract-props": "node scripts/extract-props.mjs",
    "docs:components": "node scripts/generate-components-md.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "capture-screenshots": "node scripts/capture-screenshots.mjs",
    "mcp": "node mcp/server.mjs",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gen": "node scripts/generate-smoke-tests.mjs",
    "stories:gen": "node scripts/generate-stories.mjs",
    "test:types": "vitest run ds/__tests__/types/",
    "validate:requirements": "node scripts/validate-requirements.mjs",
    "validate:search-dictionary": "node scripts/validate-search-dictionary.mjs",
    "doctor": "node scripts/junds-doctor.mjs",
    "add": "node scripts/junds-add.mjs",
    "create-app": "node scripts/create-junds-app.mjs",
    "audit:compound": "node scripts/audit-compound-api.mjs",
    "scan:motion-rtl": "node scripts/scan-motion-rtl.mjs",
    "scan:motion-rtl:strict": "node scripts/scan-motion-rtl.mjs --strict",
    "scan:ssr-rsc": "node scripts/scan-ssr-rsc.mjs",
    "scan:ssr-rsc:strict": "node scripts/scan-ssr-rsc.mjs --strict",
    "audit:a11y": "vitest run --config vitest.a11y.config.ts ds/__tests__/a11y/audit.test.tsx",
    "audit:a11y:strict": "JUNDS_AUDIT_STRICT=1 vitest run --config vitest.a11y.config.ts ds/__tests__/a11y/audit.test.tsx",
    "coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text",
    "coverage:report": "npm run coverage && node scripts/coverage-summary.mjs",
    "extract-css-vars": "node scripts/extract-css-vars.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "build:report": "node scripts/build-bundle-report.mjs && node scripts/build-deps-graph.mjs",
    "bundle:report": "node scripts/build-bundle-report.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "deps:report": "node scripts/build-deps-graph.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "prepublishOnly": "npm run build:lib",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "export-tokens": "node scripts/export-tokens.mjs",
    "prepare": "(husky 2>/dev/null || true) && npm run build:lib"
  },
