{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.lib.tsbuildinfo"
  },
  "include": ["ds/**/*.ts", "ds/**/*.tsx"],
  "exclude": [
    "node_modules",
    "ds/__tests__/**",
    "**/*.stories.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
