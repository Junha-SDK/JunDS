# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/e2e/.auth/
packages/*/test-results/
packages/*/playwright-report/

# Storybook
/storybook-static/

# AI agent visual regression PNGs (manifest is committed, PNGs are not)
/.ai/screenshots/

# AI generation script caches (manifests committed; caches not)
/.ai/.*-cache.json

# Library bundle output
/dist/

# v3 워크스페이스 산출물 (토큰 생성물 3종은 커밋 대상 — tokens-fresh 게이트)
packages/*/node_modules/
packages/*/dist/

# Swift Package Manager (v3 iOS — 04 §2.1: Xcode 프로젝트 파일은 커밋하지 않는다)
.build/
.swiftpm/
*.xcodeproj
demo/JunDSDemo.swiftpm/.build/
demo/JunDSDemo.swiftpm/.swiftpm/
