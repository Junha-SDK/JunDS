{
  "fontFamily": {
    "sans":  "'Pretendard', 'Inter', -apple-system, 'Segoe UI', sans-serif",
    "serif": "'Noto Serif KR', 'Source Serif Pro', Georgia, serif",
    "mono":  "'JetBrains Mono', 'Geist Mono', ui-monospace, monospace"
  },
  "fontSize": {
    "xs": "0.75rem",
    "sm": "0.8125rem",
    "md": "0.875rem",
    "lg": "1rem",
    "xl": "1.125rem",
    "2xl": "1.25rem",
    "3xl": "1.5rem",
    "4xl": "1.875rem",
    "5xl": "2.25rem"
